USE_MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_TREND=gpt-4o-mini
OPENAI_MODEL_CREATIVE=gpt-5.5
OPENAI_MODEL_COMPLIANCE=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-4o-mini
OPENAI_MODEL_REVISION=gpt-5.5
OPENAI_MODEL_PERFORMANCE=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
USE_MOCK_EMBEDDINGS=true
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
USE_MOCK_IMAGE_GENERATION=true

USE_MOCK_YOUTUBE=true
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=KR
YOUTUBE_RELEVANCE_LANGUAGE=ko
TREND_SEARCH_DAYS=30
MAX_RESULTS_PER_KEYWORD=10
MAX_TREND_KEYWORDS=3
TREND_PATTERN_RETENTION_DAYS=30
TREND_PATTERN_MIN_FRESHNESS_SCORE=40

APIFY_API_TOKEN=
APIFY_INSTAGRAM_TRENDING_ACTOR_ID=agentx/instagram-trending-scraper
APIFY_INSTAGRAM_COUNTRY=South Korea
APIFY_INSTAGRAM_DOWNLOAD_MEDIAS=none
APIFY_INSTAGRAM_CACHE_TTL_SECONDS=3600
